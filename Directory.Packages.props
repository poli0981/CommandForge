<Project>

  <!--
    Central Package Management: every NuGet version lives here, projects reference packages
    without a Version. Dependabot updates this file directly (see .github/dependabot.yml groups).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Keep in lockstep with the vpk tool in .config/dotnet-tools.json. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Build-time only">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.366" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- xUnit v3 on VSTest (no Microsoft Testing Platform), so `dotnet test` + coverlet keep working. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Analyzers (all projects)">
    <!-- Same rules SonarCloud applies, enforced at build time (warnings are errors). -->
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

</Project>
