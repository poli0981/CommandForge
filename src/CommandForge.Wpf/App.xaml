<Application x:Class="CommandForge.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeService swaps Light / Dark / High Contrast at runtime. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/CommandForge.Wpf;component/Theming/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WPF-UI gives every TextBlock a fixed 14 px; follow the user's font size instead. -->
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            </Style>

            <!-- An icon-only button (star, copy, move up…): no frame until hovered. -->
            <Style x:Key="IconButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
