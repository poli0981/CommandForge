<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font sizes. FontScaleService rewrites them at runtime (Small / Medium / Large); always use
         them through DynamicResource so text rescales live. Medium matches Windows 11. -->
    <sys:Double x:Key="AppFontSize">14</sys:Double>
    <sys:Double x:Key="AppFontSizeCaption">12</sys:Double>
    <sys:Double x:Key="AppFontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="AppFontSizeTitle">28</sys:Double>
    <sys:Double x:Key="AppFontSizeConsole">12.5</sys:Double>

    <FontFamily x:Key="ConsoleFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ===== Text ===== -->

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <!-- A group header above a set of cards, as in Windows Settings. -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,20,0,8" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Selectable, read-only monospace text (command lines, paths, environment details). -->
    <Style x:Key="ReadOnlyCodeTextBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeConsole}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The box around code-like text. -->
    <Style x:Key="CodeBlockBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- ===== Danger level (always shown with text or an accessible name too, never color alone) ===== -->

    <Style x:Key="DangerDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DangerLevel}" Value="Caution">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DangerLevel}" Value="Dangerous">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Console ===== -->

    <Style x:Key="ConsoleLineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeConsole}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConsoleBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- ===== Lists ===== -->

    <!-- Row text in command lists: title + one-line description. -->
    <Style x:Key="ListTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Dimmed rather than recolored: it keeps the row's own text color, so it stays readable on a
         selected (accent) row in both themes. -->
    <Style x:Key="ListDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}" />
        <Setter Property="Opacity" Value="0.78" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Placeholder shown in an empty list. -->
    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16" />
    </Style>
</ResourceDictionary>
