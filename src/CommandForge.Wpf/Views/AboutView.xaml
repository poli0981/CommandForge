<UserControl x:Class="CommandForge.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:app="clr-namespace:CommandForge.Application;assembly=CommandForge.Application">
    <!-- Shown in an in-window dialog: name, version, privacy note, links, contact addresses. -->
    <StackPanel MinWidth="380" MaxWidth="520">
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="32" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{res:Loc AppTitle}" Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{res:Loc Settings_NoDataCollected}" TextWrapping="Wrap" Margin="0,16,0,0" />

        <WrapPanel Margin="0,16,0,0">
            <ui:HyperlinkButton Content="{res:Loc Settings_License}" Click="OnLicenseClick" Margin="0,0,8,4" />
            <ui:HyperlinkButton Content="{res:Loc Settings_GitHub}" Click="OnGitHubClick" Margin="0,0,8,4" />
            <ui:HyperlinkButton Content="{res:Loc Menu_UserGuide}" Click="OnUserGuideClick" Margin="0,0,8,4" />
            <ui:HyperlinkButton Content="{res:Loc Menu_Terms}" Click="OnTermsClick" Margin="0,0,8,4" />
        </WrapPanel>

        <TextBlock Text="{res:Loc About_Contact}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,12,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{res:Loc About_SecurityContact}" Style="{StaticResource SecondaryTextStyle}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:HyperlinkButton Grid.Column="1" Content="{x:Static app:ProductLinks.SecurityEmail}" Click="OnSecurityEmailClick"
                                HorizontalAlignment="Left" AutomationProperties.HelpText="{res:Loc About_SecurityContact}" />
            <TextBlock Grid.Row="1" Text="{res:Loc About_CodeContact}" Style="{StaticResource SecondaryTextStyle}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:HyperlinkButton Grid.Row="1" Grid.Column="1" Content="{x:Static app:ProductLinks.CodeEmail}" Click="OnCodeEmailClick"
                                HorizontalAlignment="Left" AutomationProperties.HelpText="{res:Loc About_CodeContact}" />
        </Grid>
    </StackPanel>
</UserControl>
