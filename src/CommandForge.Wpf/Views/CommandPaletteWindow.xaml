<ui:FluentWindow x:Class="CommandForge.Desktop.Views.CommandPaletteWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                 xmlns:conv="clr-namespace:CommandForge.Desktop.Converters"
                 xmlns:beh="clr-namespace:CommandForge.Desktop.Behaviors"
                 Title="{res:Loc Palette_Placeholder}"
                 Width="660" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 TextElement.FontSize="{DynamicResource AppFontSize}"
                 PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <conv:IconNameToSymbolConverter x:Key="IconConverter" />
        <conv:DangerLevelToTextConverter x:Key="DangerText" />
    </Window.Resources>

    <!-- A borderless search overlay (no title bar): type, arrow keys, Enter; Esc or clicking away closes it. -->
    <DockPanel Margin="12">
        <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{res:Loc Palette_Placeholder}"
                    ClearButtonEnabled="True"
                    FontSize="{DynamicResource AppFontSizeSubtitle}"
                    AutomationProperties.Name="{res:Loc Palette_Placeholder}">
            <ui:TextBox.Icon>
                <ui:SymbolIcon Symbol="Search24" />
            </ui:TextBox.Icon>
        </ui:TextBox>

        <ListBox x:Name="ResultsList" Margin="0,8,0,0" MaxHeight="380"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult}"
                 MouseDoubleClick="OnResultDoubleClick"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{res:Loc Palette_Placeholder}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon, Converter={StaticResource IconConverter}}"
                                       FontSize="18" VerticalAlignment="Center" Margin="2,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ListTitleTextStyle}"
                                       beh:TextHighlight.Text="{Binding Title}"
                                       beh:TextHighlight.Matches="{Binding TitleMatches}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource ListDescriptionTextStyle}" />
                        </StackPanel>
                        <Ellipse Grid.Column="2" Style="{StaticResource DangerDotStyle}" Margin="10,0,2,0"
                                 ToolTip="{Binding DangerLevel, Converter={StaticResource DangerText}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</ui:FluentWindow>
