<ui:ContentDialog x:Class="CommandForge.Desktop.Views.ConfirmationDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                  xmlns:views="clr-namespace:CommandForge.Desktop.Views"
                  Title="{Binding Title}"
                  PrimaryButtonText="{res:Loc Detail_Run}"
                  CloseButtonText="{res:Loc Console_Cancel}"
                  DefaultButton="Close"
                  IsPrimaryButtonEnabled="{Binding CanRun}"
                  DialogMaxWidth="640">
    <ui:ContentDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:ContentDialog.Resources>

    <!-- Cancel is the default (Enter) and the Esc action: the safe choice is always the easy one. -->
    <StackPanel MinWidth="420">
        <views:DangerBadge Level="{Binding DangerLevel}" HorizontalAlignment="Left" Margin="0,0,0,12" />

        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="{res:Loc Detail_CommandLine}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,0,0,4" />
        <Border Style="{StaticResource CodeBlockBorderStyle}" Margin="0,0,0,12">
            <TextBox Text="{Binding CommandLine, Mode=OneWay}" Style="{StaticResource ReadOnlyCodeTextBoxStyle}"
                     AutomationProperties.Name="{res:Loc Detail_CommandLine}" />
        </Border>

        <StackPanel Margin="0,0,0,12" Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{res:Loc Confirm_TypeToConfirm}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ui:TextBox x:Name="ConfirmationInputBox"
                        Text="{Binding ConfirmationInput, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{Binding CommandId}"
                        AutomationProperties.Name="{res:Loc Confirm_TypeToConfirm}" />
        </StackPanel>

        <CheckBox IsChecked="{Binding CreateRestorePoint}"
                  Content="{res:Loc Confirm_CreateRestorePoint}"
                  Visibility="{Binding ShowRestorePointOption, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</ui:ContentDialog>
