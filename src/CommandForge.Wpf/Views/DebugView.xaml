<UserControl x:Class="CommandForge.Desktop.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:conv="clr-namespace:CommandForge.Desktop.Converters"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{res:Loc Menu_DebugPanel}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,12" />

        <TabControl Grid.Row="1">
            <TabItem Header="{res:Loc Debug_TabVerbose}">
                <DockPanel Margin="0,12,0,0">
                    <ui:Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8"
                               Content="{res:Loc Debug_Refresh}" Command="{Binding RefreshCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Border Style="{StaticResource ConsoleBorderStyle}" Padding="10,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource ReadOnlyCodeTextBoxStyle}"
                                     TextWrapping="NoWrap" AutomationProperties.Name="{res:Loc Debug_TabVerbose}" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="{res:Loc Debug_TabCatalog}">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock>
                        <Run Text="{res:Loc Debug_CategoryCount}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text=" " /><Run Text="{Binding CategoryCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="{res:Loc Debug_CommandCount}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text=" " /><Run Text="{Binding CommandCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{res:Loc Debug_ValidationErrors}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,16,0,6" />
                    <TextBlock Text="{res:Loc Debug_NoValidationErrors}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{Binding HasValidationErrors, Converter={conv:InverseBooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <TabItem Header="{res:Loc Debug_TabSystemInfo}">
                <DockPanel Margin="0,12,0,0">
                    <ui:Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8"
                               Content="{res:Loc Debug_CopySystemInfo}" Command="{Binding CopySystemInfoCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Border Style="{StaticResource CodeBlockBorderStyle}" VerticalAlignment="Top">
                        <TextBox Text="{Binding SystemInfo, Mode=OneWay}" Style="{StaticResource ReadOnlyCodeTextBoxStyle}"
                                 AutomationProperties.Name="{res:Loc Debug_TabSystemInfo}" />
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
