<ui:FluentWindow x:Class="CommandForge.Desktop.Views.ErrorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                 Title="{res:Loc Error_Title}"
                 Width="540" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 TextElement.FontSize="{DynamicResource AppFontSize}">
    <!-- A standalone window (not an in-window dialog) so it still works when the shell is broken. -->
    <StackPanel>
        <ui:TitleBar Title="{res:Loc Error_Title}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="24,4,24,20">
            <DockPanel Margin="0,0,0,12">
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ErrorCircle24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="{res:Loc Error_Message}" TextWrapping="Wrap" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{res:Loc Error_Code}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                <TextBox Text="{Binding ErrorCode, Mode=OneWay}" Style="{StaticResource ReadOnlyCodeTextBoxStyle}"
                         Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{res:Loc Error_Code}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{res:Loc Error_CopyDetails}" Command="{Binding CopyDetailsCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{res:Loc Error_ReportBug}" Command="{Binding ReportBugCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{res:Loc Error_Close}" Command="{Binding CloseCommand}" Appearance="Primary"
                           IsCancel="True" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
