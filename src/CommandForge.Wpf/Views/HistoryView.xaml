<UserControl x:Class="CommandForge.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:conv="clr-namespace:CommandForge.Desktop.Converters"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <conv:IconNameToSymbolConverter x:Key="IconConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{res:Loc History_Title}" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="{res:Loc History_Clear}" Command="{Binding ClearCommand}" VerticalAlignment="Center"
                       Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- Past runs, newest first (virtualized: the history can be long) -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Entries}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}"
                 AutomationProperties.Name="{res:Loc History_Title}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon, Converter={StaticResource IconConverter}}"
                                       FontSize="20" VerticalAlignment="Center" Margin="2,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource ListTitleTextStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="True">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Style="{StaticResource ListDescriptionTextStyle}">
                                    <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Transparent" Content="{res:Loc History_Undo}" Margin="0,0,4,0"
                                       Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Appearance="Transparent" Content="{res:Loc History_RunAgain}"
                                       IsEnabled="{Binding CanRun}"
                                       Command="{Binding DataContext.RunAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="{res:Loc History_Empty}" Style="{StaticResource EmptyStateTextStyle}"
                   Visibility="{Binding HasEntries, Converter={conv:InverseBooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
