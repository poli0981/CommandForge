<UserControl x:Class="CommandForge.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:conv="clr-namespace:CommandForge.Desktop.Converters"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <conv:IconNameToSymbolConverter x:Key="IconConverter" />
        <conv:DangerLevelToTextConverter x:Key="DangerText" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A clickable command row shared by the Recent and Favorites lists. The button names itself
             from its content (title + description), so screen readers get the same context. -->
        <DataTemplate x:Key="HomeCommandItem">
            <ui:CardAction Margin="0,0,0,4" Padding="14,10"
                           Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}"
                           AutomationProperties.Name="{Binding Title}"
                           AutomationProperties.HelpText="{Binding Description}">
                <ui:CardAction.Icon>
                    <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource IconConverter}}" />
                </ui:CardAction.Icon>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource ListTitleTextStyle}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource ListDescriptionTextStyle}" />
                    </StackPanel>
                    <Ellipse Grid.Column="1" Style="{StaticResource DangerDotStyle}" Margin="12,0,0,0"
                             ToolTip="{Binding DangerLevel, Converter={StaticResource DangerText}}" />
                </Grid>
            </ui:CardAction>
        </DataTemplate>

        <!-- One read-only status tile. -->
        <Style x:Key="StatusCardStyle" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="230" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{res:Loc SidebarHome}" Style="{StaticResource PageTitleTextStyle}" />

            <!-- System status (read-only) -->
            <TextBlock Text="{res:Loc Home_SystemStatus}" Style="{StaticResource SectionHeaderTextStyle}" />
            <WrapPanel>
                <ui:Card Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WindowApps24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{res:Loc Home_StatusOs}" Style="{StaticResource SecondaryTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding OsValue}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataUsage24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{res:Loc Home_StatusMemory}" Style="{StaticResource SecondaryTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding MemoryValue}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{res:Loc Home_StatusDisk}" Style="{StaticResource SecondaryTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiskValue}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{res:Loc Home_StatusUptime}" Style="{StaticResource SecondaryTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding UptimeValue}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </WrapPanel>

            <!-- Maintenance suggestions (local heuristics over the read-only status) -->
            <StackPanel Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{res:Loc Home_Suggestions}" Style="{StaticResource SectionHeaderTextStyle}" />
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:InfoBar Title="{Binding Reason}" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,6">
                                <ui:Button Content="{res:Loc Maint_Open}" Margin="0,4,0,0"
                                           Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                           Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding Command}" />
                            </ui:InfoBar>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Recently run commands -->
            <TextBlock Text="{res:Loc Home_Recent}" Style="{StaticResource SectionHeaderTextStyle}" />
            <Grid>
                <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource HomeCommandItem}"
                              Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{res:Loc Home_NoRecent}" Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{Binding HasRecent, Converter={conv:InverseBooleanToVisibilityConverter}}" />
            </Grid>

            <!-- Pinned favorites -->
            <TextBlock Text="{res:Loc SidebarFavorites}" Style="{StaticResource SectionHeaderTextStyle}" />
            <Grid>
                <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource HomeCommandItem}"
                              Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{res:Loc Home_NoFavorites}" Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{Binding HasFavorites, Converter={conv:InverseBooleanToVisibilityConverter}}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
