<UserControl x:Class="CommandForge.Desktop.Views.KeyboardShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:conv="clr-namespace:CommandForge.Desktop.Converters">
    <!-- The shortcuts the shell actually handles. The key column fits its widest key at any text size,
         and each row is read as "key: action". -->
    <ItemsControl x:Name="ShortcutList" MinWidth="380" Grid.IsSharedSizeScope="True"
                  AutomationProperties.Name="{res:Loc Menu_KeyboardShortcuts}">
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="AutomationProperties.Name">
                    <Setter.Value>
                        <MultiBinding Converter="{conv:FormatConverter}">
                            <Binding Source="{x:Static res:LocalizationManager.Instance}" Path="[A11y_RowAction]" />
                            <Binding Path="Key" />
                            <Binding Path="Action" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="ShortcutKey" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CodeBlockBorderStyle}" Padding="6,2"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Key}" FontFamily="{StaticResource ConsoleFontFamily}"
                                   FontSize="{DynamicResource AppFontSizeConsole}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Action}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
