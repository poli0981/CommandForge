<UserControl x:Class="CommandForge.Desktop.Views.LegalDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources">
    <!-- Each document: a short summary and a link to the full text on GitHub (Tag = URL). -->
    <TabControl>
        <TabItem Header="{res:Loc TabEula}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_EulaSummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/EULA.md" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{res:Loc TabGpl}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_GplSummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/LICENSE" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{res:Loc TabDisclaimer}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_DisclaimerSummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/DISCLAIMER.md" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{res:Loc TabPrivacy}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_PrivacySummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/PRIVACY.md" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
