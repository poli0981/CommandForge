<UserControl x:Class="CommandForge.Desktop.Views.LegalDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:conv="clr-namespace:CommandForge.Desktop.Converters">
    <UserControl.Resources>
        <!-- "Read on GitHub: EULA": the link's text, then the document it opens. -->
        <conv:RowActionNameConverter x:Key="ReadOnGitHubName" LabelKey="LegalGateReadOnGitHub" />
    </UserControl.Resources>

    <!-- Each document: a short summary and a link to the full text on GitHub (Tag = URL). -->
    <TabControl AutomationProperties.Name="{res:Loc LegalViewer_Title}">
        <TabItem Header="{res:Loc TabEula}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{res:Loc TabEula}">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_EulaSummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/EULA.md"
                                        AutomationProperties.Name="{Binding [TabEula], Source={x:Static res:LocalizationManager.Instance}, Converter={StaticResource ReadOnGitHubName}}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{res:Loc TabGpl}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{res:Loc TabGpl}">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_GplSummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/LICENSE"
                                        AutomationProperties.Name="{Binding [TabGpl], Source={x:Static res:LocalizationManager.Instance}, Converter={StaticResource ReadOnGitHubName}}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{res:Loc TabDisclaimer}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{res:Loc TabDisclaimer}">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_DisclaimerSummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/DISCLAIMER.md"
                                        AutomationProperties.Name="{Binding [TabDisclaimer], Source={x:Static res:LocalizationManager.Instance}, Converter={StaticResource ReadOnGitHubName}}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{res:Loc TabPrivacy}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{res:Loc TabPrivacy}">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="{res:Loc Legal_PrivacySummary}" TextWrapping="Wrap" />
                    <ui:HyperlinkButton Content="{res:Loc LegalGateReadOnGitHub}" Margin="-8,12,0,0" Click="OnLinkClick"
                                        Tag="https://github.com/poli0981/CommandForge/blob/main/PRIVACY.md"
                                        AutomationProperties.Name="{Binding [TabPrivacy], Source={x:Static res:LocalizationManager.Instance}, Converter={StaticResource ReadOnGitHubName}}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
