<ui:FluentWindow x:Class="CommandForge.Desktop.Views.LegalGateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                 xmlns:views="clr-namespace:CommandForge.Desktop.Views"
                 Title="{res:Loc LegalGateTitle}"
                 Width="760" Height="640" MinWidth="560" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 TextElement.FontSize="{DynamicResource AppFontSize}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{res:Loc LegalGateTitle}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="WindowConsole20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,8,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{res:Loc LegalGateTitle}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="{res:Loc LegalGateIntro}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />

            <!-- Pick the language first so the terms below are read in it. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:SymbolIcon Symbol="LocalLanguage24" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{res:Loc Settings_Language}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox MinWidth="200" ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{res:Loc Settings_Language}" />
            </StackPanel>

            <views:LegalDocumentsView Grid.Row="3" />

            <CheckBox Grid.Row="4" Margin="0,16,0,0" IsChecked="{Binding IsAgreed}" Content="{res:Loc LegalGateAgree}" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="{res:Loc LegalGateExit}" Command="{Binding ExitCommand}" Margin="0,0,8,0" IsCancel="True" />
                <ui:Button Content="{res:Loc LegalGateContinue}" Command="{Binding AcceptCommand}" Appearance="Primary" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
