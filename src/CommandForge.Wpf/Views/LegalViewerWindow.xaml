<ui:FluentWindow x:Class="CommandForge.Desktop.Views.LegalViewerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                 xmlns:views="clr-namespace:CommandForge.Desktop.Views"
                 Title="{res:Loc LegalViewer_Title}"
                 Width="760" Height="560" MinWidth="520" MinHeight="400"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 TextElement.FontSize="{DynamicResource AppFontSize}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{res:Loc LegalViewer_Title}" ShowMinimize="False" />

        <views:LegalDocumentsView Grid.Row="1" Margin="24,8,24,0" />

        <ui:Button Grid.Row="2" Content="{res:Loc ReportBug_Close}" Click="OnCloseClick" IsCancel="True" IsDefault="True"
                   HorizontalAlignment="Right" Margin="24,16,24,20" Appearance="Primary" />
    </Grid>
</ui:FluentWindow>
