<UserControl x:Class="CommandForge.Desktop.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:beh="clr-namespace:CommandForge.Desktop.Behaviors"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- Level colors from the theme; the level tag is always shown too (never color alone). -->
        <Style x:Key="LogLineStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeConsole}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Fatal">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Debug">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Verbose">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{res:Loc LogViewer_Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,12" />

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" MinWidth="150" VerticalAlignment="Center"
                      AutomationProperties.Name="{res:Loc LogViewer_Level}"
                      ItemsSource="{Binding LevelOptions}" DisplayMemberPath="DisplayName"
                      SelectedValuePath="Value" SelectedValue="{Binding SelectedLevel}" />
            <ui:TextBox Grid.Column="1" Margin="8,0" VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Stretch"
                        PlaceholderText="{res:Loc LogViewer_FilterHint}" ClearButtonEnabled="True"
                        AutomationProperties.Name="{res:Loc LogViewer_FilterHint}"
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Filter24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                      Content="{res:Loc LogViewer_AutoScroll}" IsChecked="{Binding AutoScroll}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenFolderCommand}"
                           ToolTip="{res:Loc LogViewer_OpenFolder}" AutomationProperties.Name="{res:Loc LogViewer_OpenFolder}">
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button>
                <ui:Button Style="{StaticResource IconButtonStyle}" Command="{Binding ExportZipCommand}"
                           ToolTip="{res:Loc LogViewer_Export}" AutomationProperties.Name="{res:Loc LogViewer_Export}">
                    <ui:SymbolIcon Symbol="ArrowExportLtr24" />
                </ui:Button>
                <ui:Button Style="{StaticResource IconButtonStyle}" Command="{Binding ClearCommand}"
                           ToolTip="{res:Loc LogViewer_Clear}" AutomationProperties.Name="{res:Loc LogViewer_Clear}">
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Entries (virtualized) -->
        <Border Grid.Row="2" Style="{StaticResource ConsoleBorderStyle}" Padding="10,6">
            <ListBox ItemsSource="{Binding View}"
                     Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     beh:AutoScroll.Enabled="{Binding AutoScroll}"
                     AutomationProperties.Name="{res:Loc LogViewer_Title}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="0,0,0,2" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" Margin="0,0,10,0"
                                       FontFamily="{StaticResource ConsoleFontFamily}" FontSize="{DynamicResource AppFontSizeConsole}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding LevelTag}" Width="34" FontWeight="SemiBold" Margin="0,0,10,0"
                                       Style="{StaticResource LogLineStyle}" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource LogLineStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
