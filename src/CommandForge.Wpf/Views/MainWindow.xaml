<ui:FluentWindow x:Class="CommandForge.Desktop.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                 Title="{res:Loc AppTitle}"
                 Width="1200" Height="780" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 TextElement.FontSize="{DynamicResource AppFontSize}"
                 PreviewKeyDown="OnWindowPreviewKeyDown"
                 Closing="OnWindowClosing">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{res:Loc AppTitle}" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="WindowConsole20" />
            </ui:TitleBar.Icon>

            <!-- Looks like a search box; opens the command palette (Ctrl+K). -->
            <ui:TitleBar.CenterContent>
                <ui:Button x:Name="SearchButton" Click="OnOpenPaletteClick" Width="420" Margin="24,0,0,0"
                           HorizontalAlignment="Center" HorizontalContentAlignment="Left" Padding="10,5"
                           AutomationProperties.Name="{res:Loc TitleBar_Search}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="{res:Loc TitleBar_Search}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </ui:TitleBar.CenterContent>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Shown while an elevated helper runs; its menu ends the session. -->
                    <ui:DropDownButton Appearance="Transparent" Margin="0,0,4,0" Padding="8,4"
                                       Visibility="{Binding IsAdminSessionActive, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{res:Loc Admin_SessionTooltip}"
                                       AutomationProperties.Name="{res:Loc Admin_SessionActive}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="16" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{res:Loc Admin_SessionActive}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <ui:MenuItem Header="{res:Loc Admin_EndSession}" Command="{Binding EndAdminSessionCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ShieldDismiss24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:DropDownButton Appearance="Transparent" Padding="8,4" ToolTip="{res:Loc Menu_More}"
                                       AutomationProperties.Name="{res:Loc Menu_More}">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" />
                        <ui:DropDownButton.Flyout>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <ui:MenuItem Header="{res:Loc Palette_Placeholder}" InputGestureText="Ctrl+K" Click="OnOpenPaletteClick">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Search24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_CheckForUpdates}" InputGestureText="F5" Command="{Binding CheckForUpdatesCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSyncCircle24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_RestorePoint}" Command="{Binding CreateRestorePointCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="History24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <Separator />
                                <ui:MenuItem Header="{res:Loc Menu_ExportLogs}" Command="{Binding LogViewer.ExportZipCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowExportLtr24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_OpenConfigFolder}" Command="{Binding Settings.OpenConfigFolderCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="FolderOpen24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_OpenLogFolder}" Command="{Binding Settings.OpenLogFolderCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Folder24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_PortableInfo}" Click="OnShowPortableInfoClick">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Info24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <Separator />
                                <ui:MenuItem Header="{res:Loc Menu_KeyboardShortcuts}" Click="OnShowKeyboardShortcutsClick">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Keyboard24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_UserGuide}" Command="{Binding OpenUserGuideCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="BookOpen24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_ReportBug}" Command="{Binding ReportBugCommand}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Bug24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <Separator />
                                <ui:MenuItem Header="{res:Loc Menu_Terms}" Click="OnShowTermsClick">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DocumentText24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{res:Loc Menu_About}" Click="OnShowAboutClick">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Info24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Items are built from the catalog in code; selection stays in sync with MainViewModel.NavigationKey. -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                           OpenPaneLength="290"
                           FrameMargin="0"
                           TitleBar="{Binding ElementName=AppTitleBar, Mode=OneWay}"
                           TransitionDuration="150">
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="RootSnackbar" VerticalAlignment="Bottom" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- In-window dialogs cover the whole window, title bar included. -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
