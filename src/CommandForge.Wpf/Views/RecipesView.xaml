<UserControl x:Class="CommandForge.Desktop.Views.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:conv="clr-namespace:CommandForge.Desktop.Converters"
             xmlns:views="clr-namespace:CommandForge.Desktop.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <conv:IconNameToSymbolConverter x:Key="IconConverter" />
        <conv:DangerLevelToTextConverter x:Key="DangerText" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One recipe step: icon, title, risk dot, reorder/remove. -->
        <DataTemplate x:Key="StepItem">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon, Converter={StaticResource IconConverter}}"
                               FontSize="18" VerticalAlignment="Center" Margin="2,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Ellipse Grid.Column="2" Style="{StaticResource DangerDotStyle}" Margin="8,0"
                         ToolTip="{Binding DangerLevel, Converter={StaticResource DangerText}}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource IconButtonStyle}" ToolTip="{res:Loc Recipes_MoveUp}"
                               AutomationProperties.Name="{res:Loc Recipes_MoveUp}"
                               Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="15" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource IconButtonStyle}" ToolTip="{res:Loc Recipes_MoveDown}"
                               AutomationProperties.Name="{res:Loc Recipes_MoveDown}"
                               Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="15" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource IconButtonStyle}" ToolTip="{res:Loc Recipes_RemoveStep}"
                               AutomationProperties.Name="{res:Loc Recipes_RemoveStep}"
                               Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{res:Loc SidebarRecipes}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Saved recipes -->
            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock DockPanel.Dock="Top" Text="{res:Loc Recipes_Saved}" Style="{StaticResource BodyStrongTextStyle}"
                           Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="{res:Loc Recipes_New}" Command="{Binding NewRecipeCommand}" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{res:Loc Recipe_Delete}" Command="{Binding DeleteRecipeCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <ListBox ItemsSource="{Binding RecipeNames}" SelectedItem="{Binding SelectedRecipeName}"
                         Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="{res:Loc Recipes_Saved}" />
            </DockPanel>

            <!-- Editor + console -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBox Grid.Row="0" Margin="0,0,0,8"
                            PlaceholderText="{res:Loc Recipes_NameHint}"
                            AutomationProperties.Name="{res:Loc Recipes_NameHint}"
                            Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" />

                <ui:InfoBar Grid.Row="1" Margin="0,0,0,8" Severity="Warning" IsClosable="False"
                            Title="{Binding UnavailableStepsNotice}"
                            IsOpen="{Binding UnavailableStepsNotice, Converter={conv:NullToBooleanConverter}}" />

                <!-- Steps -->
                <ui:Card Grid.Row="2" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepItem}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                        </ItemsControl>
                        <TextBlock Text="{res:Loc Recipes_NoSteps}" Style="{StaticResource EmptyStateTextStyle}">
                            <TextBlock.Visibility>
                                <Binding Path="Steps.Count">
                                    <Binding.Converter>
                                        <conv:ZeroToVisibleConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </ui:Card>

                <!-- Add step + actions -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{res:Loc Recipes_AddHint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="260" VerticalAlignment="Center"
                                  ItemsSource="{Binding AllCommands}" SelectedItem="{Binding CommandToAdd}"
                                  DisplayMemberPath="Title" IsTextSearchEnabled="True"
                                  AutomationProperties.Name="{res:Loc Recipes_AddHint}"
                                  ToolTip="{res:Loc Recipes_AddHint}" />
                        <ui:Button Content="{res:Loc Recipes_AddStep}" Command="{Binding AddStepCommand}" Margin="8,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="{res:Loc Recipes_Save}" Command="{Binding SaveRecipeCommand}" Margin="8,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Save24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{res:Loc Recipes_Run}" Command="{Binding RunRecipeCommand}" Appearance="Primary" Margin="8,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <views:ConsoleView Grid.Row="4" DataContext="{Binding Execution}" Margin="0,12,0,0"
                                   MinHeight="160" MaxHeight="320"
                                   Visibility="{Binding ShowConsole, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
