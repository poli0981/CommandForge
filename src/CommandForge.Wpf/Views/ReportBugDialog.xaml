<ui:ContentDialog x:Class="CommandForge.Desktop.Views.ReportBugDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                  Title="{res:Loc ReportBug_Title}"
                  PrimaryButtonText="{res:Loc ReportBug_OpenIssue}"
                  PrimaryButtonAppearance="Primary"
                  SecondaryButtonText="{res:Loc ReportBug_ExportLog}"
                  CloseButtonText="{res:Loc ReportBug_Close}"
                  DefaultButton="Close"
                  DialogMaxWidth="620">
    <StackPanel MinWidth="440">
        <TextBlock Text="{res:Loc ReportBug_Environment}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,0,0,4" />
        <Border Style="{StaticResource CodeBlockBorderStyle}" Margin="0,0,0,12">
            <TextBox Text="{Binding EnvironmentText, Mode=OneWay}" Style="{StaticResource ReadOnlyCodeTextBoxStyle}"
                     AutomationProperties.Name="{res:Loc ReportBug_Environment}" />
        </Border>

        <ui:TextBox MinHeight="90" MaxHeight="220" TextWrapping="Wrap" AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                    PlaceholderText="{res:Loc ReportBug_DescriptionHint}"
                    AutomationProperties.Name="{res:Loc ReportBug_DescriptionHint}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{res:Loc ReportBug_ReviewReminder}" Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</ui:ContentDialog>
