<ui:ContentDialog x:Class="CommandForge.Desktop.Views.UpdateDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
                  Title="{res:Loc Update_Title}"
                  CloseButtonText="{res:Loc Update_Close}"
                  PrimaryButtonText="{Binding DownloadButtonText}"
                  PrimaryButtonAppearance="Primary"
                  DefaultButton="Close"
                  DialogMaxWidth="520">
    <ui:ContentDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:ContentDialog.Resources>

    <StackPanel MinWidth="380">
        <!-- Checking -->
        <StackPanel Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{res:Loc Update_Checking}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{res:Loc Update_Checking}" />
        </StackPanel>

        <!-- Up to date -->
        <DockPanel Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CheckmarkCircle24" FontSize="22" Margin="0,0,10,0"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </DockPanel>

        <!-- Update available -->
        <DockPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowDownload24" FontSize="22" Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </DockPanel>

        <!-- Downloading -->
        <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{res:Loc Update_Downloading}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" AutomationProperties.Name="{res:Loc Update_Downloading}" />
            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" HorizontalAlignment="Right"
                       Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Error -->
        <DockPanel Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ErrorCircle24" FontSize="22" Margin="0,0,10,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</ui:ContentDialog>
