<UserControl x:Class="CommandForge.Desktop.Views.UserCommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:CommandForge.Desktop.Resources"
             xmlns:conv="clr-namespace:CommandForge.Desktop.Converters"
             xmlns:views="clr-namespace:CommandForge.Desktop.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{res:Loc SidebarUserCommands}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,12" />

        <!-- Always visible: these commands are not vetted and never run as administrator. -->
        <ui:InfoBar Grid.Row="1" Title="{res:Loc UserCmd_Warning}" Severity="Warning" IsOpen="True" IsClosable="False" Margin="0,0,0,12" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Saved commands -->
            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock DockPanel.Dock="Top" Text="{res:Loc UserCmd_Saved}" Style="{StaticResource BodyStrongTextStyle}"
                           Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="{res:Loc UserCmd_New}" Command="{Binding NewCommand}" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{res:Loc UserCmd_Delete}" Command="{Binding DeleteCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <Grid>
                    <ListBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}"
                             DisplayMemberPath="Name" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="{res:Loc UserCmd_Saved}" />
                    <TextBlock Text="{res:Loc UserCmd_NoCommands}" Style="{StaticResource SecondaryTextStyle}" Margin="6,8"
                               VerticalAlignment="Top" Visibility="{Binding Commands.Count, Converter={conv:ZeroToVisibleConverter}}" />
                </Grid>
            </DockPanel>

            <!-- Editor + console -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{res:Loc UserCmd_NameHint}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="{res:Loc UserCmd_NameHint}" />
                    <TextBlock Text="{res:Loc UserCmd_ExecutableHint}" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Text="{Binding EditExecutable, UpdateSourceTrigger=PropertyChanged}"
                                FontFamily="{StaticResource ConsoleFontFamily}"
                                AutomationProperties.Name="{res:Loc UserCmd_ExecutableHint}" />
                    <TextBlock Text="{res:Loc UserCmd_ArgumentsHint}" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Text="{Binding EditArguments, UpdateSourceTrigger=PropertyChanged}"
                                FontFamily="{StaticResource ConsoleFontFamily}" TextWrapping="Wrap" AcceptsReturn="False"
                                AutomationProperties.Name="{res:Loc UserCmd_ArgumentsHint}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="{res:Loc UserCmd_Save}" Command="{Binding SaveCommand}" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{res:Loc UserCmd_Run}" Command="{Binding RunCommand}" Appearance="Primary">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <views:ConsoleView Grid.Row="2" DataContext="{Binding Execution}" Margin="0,16,0,0"
                                   MinHeight="160" MaxHeight="360" VerticalAlignment="Top"
                                   Visibility="{Binding ShowConsole, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
